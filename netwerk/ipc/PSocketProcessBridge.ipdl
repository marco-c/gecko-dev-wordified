MOZ_WEBRTC
namespace
mozilla
{
namespace
net
{
/
*
*
*
PSocketProcessBridge
is
the
IPC
protocol
between
the
main
thread
in
*
the
content
process
and
the
main
thread
in
the
socket
process
.
*
We
use
this
to
create
the
PMediaTransport
protocol
between
content
process
*
and
socket
process
.
*
Once
created
PSocketProcessBridgeChild
is
the
actor
that
lives
in
*
content
process
and
PSocketProcessBridgeParent
lives
in
*
socket
process
.
*
/
[
NeedsOtherPid
ParentProc
=
Socket
ChildProc
=
Content
]
sync
protocol
PSocketProcessBridge
{
#
ifdef
MOZ_WEBRTC
parent
:
/
*
*
*
For
setting
up
the
PMediaTransport
protocol
.
*
/
async
InitMediaTransport
(
Endpoint
<
PMediaTransportParent
>
aEndpoint
)
;
#
endif
/
/
MOZ_WEBRTC
}
;
}
}
